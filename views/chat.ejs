<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat</title>
    <link rel="stylesheet" href="styles/chat.css">
    <link rel="shortcut icon" href="images/icon.jpg" type="image/x-icon">
    <script src="/socket.io/socket.io.js"></script>
</head>
<body>
    <div id="onlineUsers">
        <div id="onlineUsersIcon">
            <i class="fas fa-users"></i>
        </div>
        <div class="h1">
            <h1><%= user.email.split('@')[0].charAt(0).toUpperCase() + user.email.split('@')[0].slice(1) %></h1>
        </div>
        <ul id="userList">
            <% users.forEach(u => { %>
                <% if (u.id !== user.id) { %> 
                    <li class="user-item" data-user-id="<%= u.id %>">
                        <div class="user-avatar">
                            <span><%= u.email.split('@')[0].charAt(0).toUpperCase() %></span>
                        </div>
                        <div class="user-info">
                            <span class="user-name"><%= u.email.split('@')[0] %></span>
                            <span class="status-indicator"></span> 
                        </div>
                    </li>
                <% } %>
            <% }) %>
        </ul>
        
    </div>
    
    <div id="chat">

        <input type="hidden" id="userId" value="<%= user.id %>">
        <input type="hidden" id="receiverId" value="">
        
        <div id="anonymousToggle">
            <label for="anonymousMode">Mode Anonyme:</label>
            <input type="checkbox" id="anonymousMode">
        </div>

        <h3 id="chatWith">Discussion avec : <span id="receiverName">Personne</span></h3>
        <div id="messages"></div>
        <form id="messageForm">
            <input type="text" id="messageContent" placeholder="Ecrire votre message....." required>
            <button type="submit">Envoyer</button>
        </form>
    </div>
    <script src="/js/chat.js"></script>
</body>
</html>
